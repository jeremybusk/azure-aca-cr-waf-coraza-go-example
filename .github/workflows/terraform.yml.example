name: Terraform

on:
  pull_request:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

env:
  TF_IN_AUTOMATION: "true"
  TF_INPUT: "false"
  TF_VAR_subscription_id: ${{ vars.AZURE_SUBSCRIPTION_ID }}

jobs:
  validate:
    name: Validate
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v6

      - name: Set up Terraform
        uses: hashicorp/setup-terraform@v4

      - name: Check formatting
        run: terraform fmt -check -recursive

      - name: Validate Terraform stacks
        run: |
          for directory in . bootstrap infrastructure/container-registry
          do
            terraform -chdir="$directory" init -backend=false
            terraform -chdir="$directory" validate
          done

      - name: Validate GeoIP policy generator
        run: |
          python -m pip install --disable-pip-version-check PyYAML==6.0.2
          python applications/hello-world/scripts/generate_geoip_policy.py \
            --input applications/hello-world/config/geoip-policy.yaml \
            --output /tmp/geoip-policy.caddy \
            --enabled-marker /tmp/geoip-enabled
          test -s /tmp/geoip-policy.caddy
          python -m unittest discover \
            --start-directory applications/hello-world/tests \
            --pattern 'test_*.py'

  deploy:
    name: Build, plan and apply
    if: github.event_name != 'pull_request'
    needs: validate
    runs-on: ubuntu-latest
    environment: azure
    concurrency:
      group: terraform-azure
      cancel-in-progress: false
    permissions:
      contents: read
      id-token: write

    steps:
      - name: Check out repository
        uses: actions/checkout@v6

      - name: Check Azure OIDC configuration
        env:
          AZURE_CLIENT_ID: ${{ vars.AZURE_CLIENT_ID }}
          AZURE_TENANT_ID: ${{ vars.AZURE_TENANT_ID }}
          AZURE_SUBSCRIPTION_ID: ${{ vars.AZURE_SUBSCRIPTION_ID }}
          TF_STATE_RESOURCE_GROUP: ${{ vars.TF_STATE_RESOURCE_GROUP }}
          TF_STATE_STORAGE_ACCOUNT: ${{ vars.TF_STATE_STORAGE_ACCOUNT }}
          TF_STATE_CONTAINER: ${{ vars.TF_STATE_CONTAINER }}
          ACR_NAME: ${{ vars.ACR_NAME }}
          ACR_LOGIN_SERVER: ${{ vars.ACR_LOGIN_SERVER }}
          ACR_PULL_IDENTITY_ID: ${{ vars.ACR_PULL_IDENTITY_ID }}
          CONTAINER_IMAGE_REPOSITORY: ${{ vars.CONTAINER_IMAGE_REPOSITORY }}
          GEOIP_DATABASE_VERSION: ${{ vars.GEOIP_DATABASE_VERSION }}
        run: |
          missing=0
          for name in \
            AZURE_CLIENT_ID \
            AZURE_TENANT_ID \
            AZURE_SUBSCRIPTION_ID \
            TF_STATE_RESOURCE_GROUP \
            TF_STATE_STORAGE_ACCOUNT \
            TF_STATE_CONTAINER \
            ACR_NAME \
            ACR_LOGIN_SERVER \
            ACR_PULL_IDENTITY_ID \
            CONTAINER_IMAGE_REPOSITORY \
            GEOIP_DATABASE_VERSION
          do
            if [ -z "$(printenv "$name")" ]; then
              echo "::error::$name is not configured as a GitHub Actions variable"
              missing=1
            fi
          done
          if [ "$missing" -ne 0 ]; then
            exit 1
          fi
          echo "Expected federated subject: repo:jeremybusk@19394715/azuresdx1@1312417313:environment:azure"

      - name: Log in to Azure with OIDC
        uses: azure/login@v3
        with:
          client-id: ${{ vars.AZURE_CLIENT_ID }}
          tenant-id: ${{ vars.AZURE_TENANT_ID }}
          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}
          auth-type: SERVICE_PRINCIPAL

      - name: Restore versioned GeoLite2 database
        id: geolite-cache
        uses: actions/cache@v4
        with:
          path: ${{ runner.temp }}/GeoLite2-Country.tar.gz
          key: geolite2-country-${{ vars.GEOIP_DATABASE_VERSION }}

      - name: Check MaxMind configuration
        if: steps.geolite-cache.outputs.cache-hit != 'true'
        env:
          MAXMIND_ACCOUNT_ID: ${{ vars.MAXMIND_ACCOUNT_ID }}
          MAXMIND_LICENSE_KEY: ${{ secrets.MAXMIND_LICENSE_KEY }}
        run: |
          missing=0
          for name in MAXMIND_ACCOUNT_ID MAXMIND_LICENSE_KEY
          do
            if [ -z "$(printenv "$name")" ]; then
              echo "::error::$name is not configured in the GitHub azure environment"
              missing=1
            fi
          done
          test "$missing" -eq 0

      - name: Download current GeoLite2 Country database
        if: steps.geolite-cache.outputs.cache-hit != 'true'
        env:
          MAXMIND_ACCOUNT_ID: ${{ vars.MAXMIND_ACCOUNT_ID }}
          MAXMIND_LICENSE_KEY: ${{ secrets.MAXMIND_LICENSE_KEY }}
        run: |
          curl \
            --fail \
            --location \
            --silent \
            --show-error \
            --user "${MAXMIND_ACCOUNT_ID}:${MAXMIND_LICENSE_KEY}" \
            --output "${RUNNER_TEMP}/GeoLite2-Country.tar.gz" \
            "https://download.maxmind.com/geoip/databases/GeoLite2-Country/download?suffix=tar.gz"

      - name: Validate GeoLite2 Country archive
        run: |
          test -s "${RUNNER_TEMP}/GeoLite2-Country.tar.gz"
          tar -tzf "${RUNNER_TEMP}/GeoLite2-Country.tar.gz" \
            | grep -q '/GeoLite2-Country.mmdb$'

      - name: Log in to Azure Container Registry
        run: az acr login --name "${{ vars.ACR_NAME }}"

      - name: Build and push immutable application image
        env:
          DOCKER_BUILDKIT: "1"
          IMAGE: ${{ vars.ACR_LOGIN_SERVER }}/${{ vars.CONTAINER_IMAGE_REPOSITORY }}:${{ github.sha }}
        run: |
          mkdir -p applications/hello-world/.build
          cp "${RUNNER_TEMP}/GeoLite2-Country.tar.gz" \
            applications/hello-world/.build/GeoLite2-Country.tar.gz
          trap 'rm -f applications/hello-world/.build/GeoLite2-Country.tar.gz' EXIT
          docker build \
            --label "org.opencontainers.image.revision=${GITHUB_SHA}" \
            --tag "$IMAGE" \
            applications/hello-world
          docker run --rm "$IMAGE" \
            caddy validate \
            --config /etc/caddy/Caddyfile \
            --adapter caddyfile
          docker push "$IMAGE"
          echo "TF_VAR_container_image=$IMAGE" >> "$GITHUB_ENV"
          echo "TF_VAR_container_registry_server=${{ vars.ACR_LOGIN_SERVER }}" >> "$GITHUB_ENV"
          echo "TF_VAR_container_registry_identity_id=${{ vars.ACR_PULL_IDENTITY_ID }}" >> "$GITHUB_ENV"

      - name: Set up Terraform
        uses: hashicorp/setup-terraform@v4

      - name: Initialize remote state
        run: |
          terraform init \
            -backend-config="resource_group_name=${{ vars.TF_STATE_RESOURCE_GROUP }}" \
            -backend-config="storage_account_name=${{ vars.TF_STATE_STORAGE_ACCOUNT }}" \
            -backend-config="container_name=${{ vars.TF_STATE_CONTAINER }}" \
            -backend-config="key=azuresdx1/prod/hello-nginx.tfstate" \
            -backend-config="use_azuread_auth=true"

      - name: Create saved plan
        run: terraform plan -out=tfplan

      - name: Apply saved plan
        run: terraform apply -auto-approve tfplan
