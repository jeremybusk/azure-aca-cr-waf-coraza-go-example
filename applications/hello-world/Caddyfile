{
	admin off
	auto_https off
	order coraza_waf first
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	import /opt/app/geoip-policy.caddy

	coraza_waf {
		include /templates/coraza-rules.conf
	}

	@apex host uvoo.xyz
	redir @apex https://www.uvoo.xyz{uri} permanent

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cache-Control no-cache
	}

	root * /opt/app/public
	file_server
}
